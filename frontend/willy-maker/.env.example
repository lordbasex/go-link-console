#
# Build-time settings for Willy Maker's site. Copy to willy-maker/.env.local
# for local development (ignored by git).

# go-link's rooms, which keep the link to the owner's go-link (their
# /maker-bridge tab). Default: VITE_SITE_URL in development,
# https://play.go-link.org in a build.
# VITE_PLAY_URL=https://play.go-link.org

# go-link's landing, where the games made before Willy Maker had its own
# site are (its /maker-bridge tab). Default: http://localhost:5180 in
# development, https://console.go-link.org in a build.
# VITE_SITE_URL=https://console.go-link.org

# Optional Chrome origin trial tokens, comma separated, for built-in AI APIs
# still in trial (Proofreader, the Prompt API's audio). Register each one for
# the site's origin at https://developer.chrome.com/origintrials.
# VITE_ORIGIN_TRIAL_TOKENS=
